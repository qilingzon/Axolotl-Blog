---
/**
 * 七色美西螈轮换组件：七张变体图同位叠加，纯 CSS 交叉淡入轮换。
 * 与加载层同机制：每张图的负延迟对准自己色槽"淡入完成"的时刻，
 * 渲染时钟被节流冻结时也恰有一只完整可见（兜底显示粉螈）。
 */
interface Props {
  /** 显示宽度 px */
  size?: number;
  /** 轮换整周期秒数（默认 2.8s，每色槽 = period/7） */
  period?: number;
  /** 相位偏移秒数，用于多实例错开颜色 */
  phase?: number;
  class?: string;
}

const { size = 64, period = 2.8, phase = 0, class: className } = Astro.props;

const variants = [
  '/assets/axolotl-launcher.png',
  '/assets/axolotl-purple.png',
  '/assets/axolotl-wild.png',
  '/assets/axolotl-cyan.png',
  '/assets/axolotl-gold.png',
  '/assets/axolotl-blue.png',
  '/assets/axolotl-green.png',
];

const slot = period / 7;
const fade = 0.06;
const height = Math.round((size * 191) / 256);
---

<div class:list={['axo-cycle', className]} style={`width:${size}px;height:${height}px;--p:${period}s;`}>
  {
    variants.map((src, i) => (
      <img
        class="axo-cycle__img"
        src={src}
        alt=""
        width={size}
        height={height}
        style={`--d:${-((i * slot) + fade + phase)}s;`}
        loading="lazy"
        decoding="async"
      />
    ))
  }
</div>

<style>
  .axo-cycle {
    position: relative;
    display: inline-block;
    vertical-align: middle;
  }

  .axo-cycle__img {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 100%;
    height: 100%;
    opacity: 0;
    animation: axo-cycle-fade var(--p) linear infinite;
    animation-delay: var(--d);
  }

  /* 兜底：动画不可用时至少显示粉螈 */
  .axo-cycle__img:first-child {
    opacity: 1;
  }

  /* 每周期 7 槽：快速淡入(2%) → 停留 → 淡出(14.28%=100/7) */
  @keyframes axo-cycle-fade {
    0% {
      opacity: 0;
    }
    2% {
      opacity: 1;
    }
    12% {
      opacity: 1;
    }
    14.28% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .axo-cycle__img {
      animation: none;
    }

    .axo-cycle__img:not(:first-child) {
      opacity: 0;
    }
  }
</style>
