---
import { SITE } from '../config';
import AxolotlRandom from './AxolotlRandom.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p>
      <AxolotlRandom slotName="footer-a" size={22} />
      <AxolotlRandom slotName="footer-b" size={22} />
      © {year} {SITE.name} · 由两只随机出没的美西螈共同守护
    </p>
    <p>
      用 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建 ·
      灵感来自 Minecraft 美西螈 ·
      <a href="/rss.xml">RSS 订阅</a>
    </p>
    <p class="icp">
      <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">桂ICP备2025078799号-2</a>
    </p>
  </div>
</footer>
