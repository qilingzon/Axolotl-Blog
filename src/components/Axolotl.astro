---
/**
 * 美西螈吉祥物组件：形象取自 Axolotl Launcher（桌面启动器）的应用图标，
 * 全家族色变体由 scripts/generate-variants.mjs 按官方色板重上色生成：
 * pink=lucy 粉（启动器原图）/ purple 紫（站点二创）/ wild 棕 / cyan 青（粉鳃）/ gold 金 / blue 蓝（官方色板）
 * / green 绿（Minecraft Live 2020 预告片展示后被砍的变体，彩蛋成员）
 */
type Variant = 'pink' | 'purple' | 'wild' | 'cyan' | 'gold' | 'blue' | 'green';

interface Props {
  variant?: Variant;
  size?: number;
  /** 兼容旧 API（face/swim），现在两种模式都用同一头像图 */
  mode?: 'face' | 'swim';
  class?: string;
}

const { variant = 'pink', size = 64, class: className } = Astro.props;

const srcs: Record<Variant, string> = {
  pink: '/assets/axolotl-launcher.png',
  purple: '/assets/axolotl-purple.png',
  wild: '/assets/axolotl-wild.png',
  cyan: '/assets/axolotl-cyan.png',
  gold: '/assets/axolotl-gold.png',
  blue: '/assets/axolotl-blue.png',
  green: '/assets/axolotl-green.png',
};
const labels: Record<Variant, string> = {
  pink: '粉色美西螈',
  purple: '紫色美西螈',
  wild: '野生色美西螈',
  cyan: '青色美西螈',
  gold: '金色美西螈',
  blue: '蓝色美西螈',
  green: '绿色美西螈',
};
---

<img
  src={srcs[variant]}
  alt={labels[variant]}
  width={size}
  height={Math.round((size * 191) / 256)}
  class:list={['axolotl', className]}
  loading="lazy"
  decoding="async"
/>
