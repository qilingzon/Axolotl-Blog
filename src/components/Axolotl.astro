---
/**
 * 美西螈吉祥物组件：形象取自 Axolotl Launcher（桌面启动器）的应用图标，
 * 粉色为原图，紫色变体用 CSS 色相旋转实时生成。
 * 资源：public/assets/axolotl-launcher.png（256×191，透明背景）
 */
interface Props {
  variant?: 'pink' | 'purple';
  size?: number;
  /** 兼容旧 API（face/swim），现在两种模式都用同一头像图 */
  mode?: 'face' | 'swim';
  class?: string;
}

const { variant = 'pink', size = 64, class: className } = Astro.props;

const src = '/assets/axolotl-launcher.png';
const label = variant === 'pink' ? '粉色美西螈' : '紫色美西螈';
---

<img
  src={src}
  alt={label}
  width={size}
  height={Math.round((size * 191) / 256)}
  class:list={['axolotl', variant === 'purple' && 'axolotl--purple', className]}
  loading="lazy"
  decoding="async"
/>

<style>
  .axolotl {
    display: inline-block;
    vertical-align: middle;
    height: auto;
  }

  .axolotl--purple {
    filter: hue-rotate(-55deg) saturate(1.08);
  }
</style>
