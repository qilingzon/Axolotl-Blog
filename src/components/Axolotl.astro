---
/**
 * 美西螈吉祥物组件：形象取自 Axolotl Launcher（桌面启动器）的应用图标。
 * 五个色系（对应 Minecraft 美西螈变体）全部由 CSS 滤镜从粉色原图生成：
 * pink 粉 / purple 紫 / cyan 青 / gold 金 / blue 蓝
 * 资源：public/assets/axolotl-launcher.png（256×191，透明背景）
 */
type Variant = 'pink' | 'purple' | 'cyan' | 'gold' | 'blue';

interface Props {
  variant?: Variant;
  size?: number;
  /** 兼容旧 API（face/swim），现在两种模式都用同一头像图 */
  mode?: 'face' | 'swim';
  class?: string;
}

const { variant = 'pink', size = 64, class: className } = Astro.props;

const src = '/assets/axolotl-launcher.png';
const labels: Record<Variant, string> = {
  pink: '粉色美西螈',
  purple: '紫色美西螈',
  cyan: '青色美西螈',
  gold: '金色美西螈',
  blue: '蓝色美西螈',
};
---

<img
  src={src}
  alt={labels[variant]}
  width={size}
  height={Math.round((size * 191) / 256)}
  class:list={['axolotl', variant !== 'pink' && `axolotl--${variant}`, className]}
  loading="lazy"
  decoding="async"
/>
