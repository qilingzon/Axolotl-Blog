---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Axolotl from '../../components/Axolotl.astro';
import { SITE } from '../../config';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  const sorted = posts.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return sorted.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: sorted[i - 1] ?? null, next: sorted[i + 1] ?? null },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, tags, accent } = post.data;
const dateStr = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
// 构建时刻：探针脚本用它与 KV 里的保存时间比对，只有「保存晚于构建」才热替换
const BUILD_TIME = Date.now();
---

<BaseLayout title={title} description={description}>
  <article class="container post">
    <header class="post__head">
      <a class="post__back" href="/blog/">← 全部文章</a>
      <h1 class="post__title">{title}</h1>
      <div class="post__meta">
        <Axolotl variant={accent} mode="face" size={36} />
        <time datetime={pubDate.toISOString()}>{dateStr}</time>
        {
          tags.length > 0 && (
            <div class="post__tags">
              {tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          )
        }
      </div>
    </header>
    <div class="prose post__body">
      <Content />
    </div>
    <nav class="post__nav">
      {
        prev ? (
          <a class="card post__nav-item" href={`/blog/${prev.id}/`}>
            <span class="post__nav-label">上一篇</span>
            <span>{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="card post__nav-item post__nav-item--next" href={`/blog/${next.id}/`}>
            <span class="post__nav-label">下一篇</span>
            <span>{next.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
  <script is:inline define:vars={{ slug: post.id, builtAt: BUILD_TIME, siteName: SITE.name }}>
    // KV 热替换探针：攒批保存的最新版晚于本页构建时刻时，原位换正文/标题/日期/标签。
    // 探针是纯增强——KV 未绑/请求失败/版本不比构建新，页面都保持构建版原样
    (function () {
      try {
        fetch('/p/' + encodeURIComponent(slug) + '?fmt=json')
          .then(function (r) {
            return r.ok ? r.json() : null;
          })
          .then(function (d) {
            // typeof 严格校验：字符串 "abc" 与 builtAt 比较得 NaN 会绕过 <= 守卫；
            // d.draft = 作者勾了草稿：这是编辑中版本，绝不能热替换给访客，保持构建版
            if (!d || typeof d.at !== 'number' || d.at <= builtAt || !d.html || d.draft) return;
            var bodyEl = document.querySelector('.post__body');
            if (bodyEl) bodyEl.innerHTML = d.html;
            var titleEl = document.querySelector('.post__title');
            if (titleEl && d.title) {
              titleEl.textContent = d.title;
              document.title = d.title + ' · ' + siteName;
            }
            // 日期同步：正文换了日期还挂着构建时的旧值会张冠李戴
            if (d.pubDate) {
              var timeEl = document.querySelector('time[datetime]');
              var dt = new Date(d.pubDate);
              if (timeEl && !isNaN(dt.getTime())) {
                timeEl.setAttribute('datetime', dt.toISOString());
                timeEl.textContent = dt.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
              }
            }
            // 标签同步：重建 .post__tags（新标签空则整个摘除，与构建口径一致）
            if (Array.isArray(d.tags)) {
              var headEl = document.querySelector('.post__meta');
              var tagsEl = document.querySelector('.post__tags');
              if (headEl) {
                if (d.tags.length) {
                  if (!tagsEl) {
                    tagsEl = document.createElement('div');
                    tagsEl.className = 'post__tags';
                    headEl.appendChild(tagsEl);
                  }
                  while (tagsEl.firstChild) tagsEl.removeChild(tagsEl.firstChild);
                  d.tags.forEach(function (t) {
                    var s = document.createElement('span');
                    s.className = 'tag';
                    s.textContent = String(t);
                    tagsEl.appendChild(s);
                  });
                } else if (tagsEl) {
                  tagsEl.remove();
                }
              }
            }
          })
          .catch(function () {});
      } catch (e) {}
    })();
  </script>
</BaseLayout>

<style>
  .post {
    max-width: 800px;
    padding: 40px 24px 0;
  }

  .post__back {
    font-family: var(--font-display);
    font-size: 14px;
  }

  .post__title {
    font-size: clamp(28px, 5vw, 40px);
    margin: 12px 0 14px;
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: 14px;
    padding-bottom: 22px;
    border-bottom: var(--border-w) dashed var(--border);
    margin-bottom: 30px;
  }

  .post__tags {
    display: flex;
    gap: 6px;
  }

  .post__body {
    margin: 0 auto;
  }

  .post__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 52px 0 0;
    padding-bottom: 8px;
  }

  .post__nav-item {
    padding: 16px 20px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--text);
  }

  .post__nav-item--next {
    text-align: right;
  }

  .post__nav-label {
    display: block;
    font-family: var(--font-display);
    font-size: 12.5px;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  @media (max-width: 720px) {
    .post__nav {
      grid-template-columns: 1fr;
    }
  }
</style>
