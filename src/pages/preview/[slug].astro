---
// 草稿预览路由：/preview/{slug}/ —— 只为「存了草稿想看看效果」服务。
// 不进任何列表/搜索/sitemap；noindex,nofollow 不入搜索引擎索引；知道直链才能访问（个人站可接受的隐蔽性）。
import BaseLayout from '../../layouts/BaseLayout.astro';
import Axolotl from '../../components/Axolotl.astro';
import { SITE } from '../../config';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog'); // 注意：含草稿——这正是本路由存在的意义
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, tags, accent, draft } = post.data;
const dateStr = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
// 构建时刻：探针用它与 KV 保存时间比对（与 blog/[slug] 同机制）
const BUILD_TIME = Date.now();
---

<BaseLayout title={title} description={description} noindex>
  <article class="container post preview-post">
    <div class="preview-banner">
      <Axolotl variant={accent} mode="face" size={22} />
      <span>
        这是{draft ? '草稿' : '文章'}「{title}」的预览，只有知道链接的人能看到，搜索引擎不会收录。
      </span>
      <a href="/admin/#/editor/{post.id}">去后台编辑</a>
    </div>
    <header class="post__head">
      <h1 class="post__title">{title}</h1>
      <div class="post__meta">
        <Axolotl variant={accent} mode="face" size={36} />
        <time datetime={pubDate.toISOString()}>{dateStr}</time>
        {
          tags.length > 0 && (
            <div class="post__tags">
              {tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          )
        }
      </div>
    </header>
    <div class="prose post__body">
      <Content />
    </div>
  </article>
  <script is:inline define:vars={{ slug: post.id, builtAt: BUILD_TIME, siteName: SITE.name }}>
    // KV 热替换探针（与 blog/[slug] 同机制）：攒批保存的草稿新版晚于构建时刻时原位替换。
    // 这里是作者私密预览页，草稿内容照常替换（预览草稿本就是这个页面的职责）
    (function () {
      try {
        fetch('/p/' + encodeURIComponent(slug) + '?fmt=json')
          .then(function (r) {
            return r.ok ? r.json() : null;
          })
          .then(function (d) {
            // typeof 严格校验：非数字 at 与 builtAt 比较得 NaN 会绕过 <= 守卫
            if (!d || typeof d.at !== 'number' || d.at <= builtAt || !d.html) return;
            var bodyEl = document.querySelector('.post__body');
            if (bodyEl) bodyEl.innerHTML = d.html;
            var titleEl = document.querySelector('.post__title');
            if (titleEl && d.title) {
              titleEl.textContent = d.title;
              document.title = d.title + ' · ' + siteName;
            }
            // 日期与标签同步（口径与文章页一致）
            if (d.pubDate) {
              var timeEl = document.querySelector('time[datetime]');
              var dt = new Date(d.pubDate);
              if (timeEl && !isNaN(dt.getTime())) {
                timeEl.setAttribute('datetime', dt.toISOString());
                timeEl.textContent = dt.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
              }
            }
            if (Array.isArray(d.tags)) {
              var headEl = document.querySelector('.post__meta');
              var tagsEl = document.querySelector('.post__tags');
              if (headEl) {
                if (d.tags.length) {
                  if (!tagsEl) {
                    tagsEl = document.createElement('div');
                    tagsEl.className = 'post__tags';
                    headEl.appendChild(tagsEl);
                  }
                  while (tagsEl.firstChild) tagsEl.removeChild(tagsEl.firstChild);
                  d.tags.forEach(function (t) {
                    var s = document.createElement('span');
                    s.className = 'tag';
                    s.textContent = String(t);
                    tagsEl.appendChild(s);
                  });
                } else if (tagsEl) {
                  tagsEl.remove();
                }
              }
            }
          })
          .catch(function () {});
      } catch (e) {}
    })();
  </script>
</BaseLayout>

<style>
  .preview-post {
    max-width: 800px;
    padding: 28px 24px 0;
  }

  .preview-banner {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-family: var(--font-display);
    font-size: 13px;
    color: var(--text-muted);
    background: var(--bg-soft);
    border: var(--border-w) dashed var(--border);
    border-radius: var(--radius);
    padding: 10px 14px;
    margin-bottom: 22px;
  }

  .preview-banner a {
    color: var(--accent);
    margin-left: auto;
  }

  .post__title {
    font-size: clamp(28px, 5vw, 40px);
    margin: 12px 0 14px;
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: 14px;
    padding-bottom: 22px;
    border-bottom: var(--border-w) dashed var(--border);
    margin-bottom: 30px;
  }

  .post__tags {
    display: flex;
    gap: 6px;
  }

  .post__body {
    margin: 0 auto;
  }
</style>
