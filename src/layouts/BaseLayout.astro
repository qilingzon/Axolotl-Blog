---
import '@fontsource/fusion-pixel-12px-proportional-sc/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, THEMES, THEME_STORAGE_KEY } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.nameEn}`;
---

<!doctype html>
<html lang="zh-CN" data-theme="pink-soft">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" as="image" href="/assets/axolotl-launcher.png" />
    <script is:inline>
      // 防闪烁：首帧前确定主题。?theme= 参数优先于 localStorage（用于分享带主题的链接），不写入存储。
      // 加载界面为七色轮换，无需按主题挑变体；会话内只展示一次。
      (function () {
        var t = 'pink-soft';
        try {
          t = new URLSearchParams(location.search).get('theme') || localStorage.getItem('axo-theme') || 'pink-soft';
        } catch (e) {}
        if (t !== 'pink-soft' && t !== 'purple-pixel' && t !== 'lumen-cave') t = 'pink-soft';
        document.documentElement.dataset.theme = t;
        var seen = null;
        try {
          seen = sessionStorage.getItem('axo-splash-seen');
        } catch (e) {}
        if (seen) document.documentElement.classList.add('no-splash');
        // 首页 hero 双螈：每次访问随机两只（颜色必不同），停留期间保持稳定
        var V = ['pink', 'purple', 'wild', 'cyan', 'gold', 'blue', 'green'];
        var bi = Math.floor(Math.random() * 7);
        var sj = Math.floor(Math.random() * 6);
        if (sj >= bi) sj++;
        document.documentElement.dataset.heroBig = V[bi];
        document.documentElement.dataset.heroSmall = V[sj];
      })();
    </script>
  </head>
  <body>
    <div id="splash" class="splash" aria-hidden="true">
      <div class="splash__inner">
        <div class="splash__pond">
          <span class="splash__bubble splash__bubble--1"></span>
          <span class="splash__bubble splash__bubble--2"></span>
          <span class="splash__bubble splash__bubble--3"></span>
          <img class="splash__axolotl splash__axolotl--1" src="/assets/axolotl-launcher.png" alt="" width="150" height="112" />
          <img class="splash__axolotl splash__axolotl--2" src="/assets/axolotl-purple.png" alt="" width="150" height="112" />
          <img class="splash__axolotl splash__axolotl--3" src="/assets/axolotl-wild.png" alt="" width="150" height="112" />
          <img class="splash__axolotl splash__axolotl--4" src="/assets/axolotl-cyan.png" alt="" width="150" height="112" />
          <img class="splash__axolotl splash__axolotl--5" src="/assets/axolotl-gold.png" alt="" width="150" height="112" />
          <img class="splash__axolotl splash__axolotl--6" src="/assets/axolotl-blue.png" alt="" width="150" height="112" />
          <img class="splash__axolotl splash__axolotl--7" src="/assets/axolotl-green.png" alt="" width="150" height="112" />
        </div>
        <div class="splash__bar"><i></i></div>
        <p class="splash__text">正在游向池塘</p>
      </div>
    </div>
    <script is:inline>
      // 加载界面：load 后至少展示 0.7s 再淡出；本会话不再重复；3s 兜底强退。
      (function () {
        var el = document.getElementById('splash');
        if (!el) return;
        if (document.documentElement.classList.contains('no-splash')) {
          el.remove();
          return;
        }
        var t0 = Date.now();
        var done = false;
        function hide() {
          if (done) return;
          done = true;
          el.classList.add('splash--out');
          try {
            sessionStorage.setItem('axo-splash-seen', '1');
          } catch (e) {}
          setTimeout(function () {
            el.remove();
          }, 450);
        }
        function ready() {
          var min =
            matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 700;
          setTimeout(hide, Math.max(0, min - (Date.now() - t0)));
        }
        if (document.readyState === 'complete') ready();
        else window.addEventListener('load', ready);
        setTimeout(hide, 3000);
        window.addEventListener('pageshow', function (e) {
          if (e.persisted) hide();
        });
      })();
    </script>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline define:vars={{ THEMES, THEME_STORAGE_KEY }}>
      // 主题循环切换（事件委托，全站生效）
      (function () {
        var themes = THEMES;
        function currentTheme() {
          return (
            themes.find(function (t) {
              return t.id === document.documentElement.dataset.theme;
            }) || themes[0]
          );
        }
        function updateSwitcher() {
          var btn = document.getElementById('theme-switcher');
          if (!btn) return;
          var cur = currentTheme();
          btn.querySelector('.theme-switcher__dot').style.background = cur.dot;
          var name = btn.querySelector('.theme-switcher__name');
          if (name) name.textContent = cur.label;
        }
        document.addEventListener('click', function (e) {
          var btn = e.target.closest('#theme-switcher');
          if (!btn) return;
          var ids = themes.map(function (t) {
            return t.id;
          });
          var next = ids[(ids.indexOf(currentTheme().id) + 1) % ids.length];
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem(THEME_STORAGE_KEY, next);
          } catch (err) {}
          updateSwitcher();
        });
        document.addEventListener('astro:after-swap', updateSwitcher);
        updateSwitcher();
      })();
    </script>
  </body>
</html>
